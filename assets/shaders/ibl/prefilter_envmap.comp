// assets/shaders/ibl/prefilter_envmap.comp
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube uEnvironmentMap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uOutputFace;

layout(push_constant) uniform PC {
    int   face;
    float faceSize;
    float roughness;
} pc;

const float PI = 3.14159265359;
const uint  SAMPLE_COUNT = 1024u;

// ── Hammersley ──
float RadicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

// ── GGX 重要性采样 ──
vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a = roughness * roughness;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangentX = normalize(cross(up, N));
    vec3 tangentY = cross(N, tangentX);

    return tangentX * H.x + tangentY * H.y + N * H.z;
}

// ── 像素 → 方向 ──
vec3 FaceToDirection(int face, float u, float v, float size) {
    float x = (u + 0.5) / size * 2.0 - 1.0;
    float y = (v + 0.5) / size * 2.0 - 1.0;
    vec3 dir;
    switch (face) {
        case 0: dir = vec3( 1.0, -y, -x); break;
        case 1: dir = vec3(-1.0, -y,  x); break;
        case 2: dir = vec3( x,  1.0,  y); break;
        case 3: dir = vec3( x, -1.0, -y); break;
        case 4: dir = vec3( x, -y,  1.0); break;
        case 5: dir = vec3(-x, -y, -1.0); break;
    }
    return normalize(dir);
}

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;

    if (px >= uint(pc.faceSize) || py >= uint(pc.faceSize)) return;

    vec3 N = FaceToDirection(pc.face, float(px), float(py), pc.faceSize);
    vec3 V = N;

    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H  = ImportanceSampleGGX(Xi, N, pc.roughness);
        vec3 L  = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0) {
            prefilteredColor += textureLod(uEnvironmentMap, L, 0.0).rgb * NdotL;
            totalWeight      += NdotL;
        }
    }
    prefilteredColor = prefilteredColor / max(totalWeight, 0.001);

    imageStore(uOutputFace, ivec2(px, py), vec4(prefilteredColor, 1.0));
}