#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer ParticleBuffer {
    vec4 particles[];  // xyz=position, w=life(0→1)
} uParticles;

layout(push_constant) uniform PC {
    float deltaTime;
    uint  particleCount;
    // ── 可调粒子参数 ──
    float gravity;       // 重力（负=下落）
    float speedMin;      // 初始速度下限
    float speedMax;      // 初始速度上限
    float lifetime;      // 粒子寿命（秒）
    float spreadXZ;      // 喷口水平散布半径
    float swayFreq;      // 水平摆动频率
    float swayAmp;       // 水平摆动幅度
    float emitterY;      // 喷口 Y 坐标
    float topDiffuse;    // 顶部扩散强度
    float topThreshold;  // 开始扩散的高度阈值
} pc;

float hash(uint x) {
    x = (x ^ 61u) ^ (x >> 16u); x *= 9u; x = x ^ (x >> 4u);
    x *= 0x27d4eb2du; x = x ^ (x >> 15u);
    return float(x) / float(0xFFFFFFFFu);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particleCount) return;

    vec4 p = uParticles.particles[idx];
    float life = p.w;
    float dt = min(pc.deltaTime, 0.05);

    // ── 生命周期 ──
    life -= dt / pc.lifetime;

    if (life <= 0.0) {
        // 重生
        uint seed = idx * 4u + uint(pc.deltaTime * 1000.0) % 10000u;
        p.x = (hash(seed)   - 0.5) * pc.spreadXZ * 2.0;
        p.y = pc.emitterY + (hash(seed+1) - 0.5) * pc.spreadXZ;
        p.z = (hash(seed+2) - 0.5) * pc.spreadXZ * 2.0;
        life = 0.85 + hash(seed+3) * 0.15;
    }

    // ── 运动 ──
    float t = 1.0 - life;
    float speed = mix(pc.speedMax, pc.speedMin, t);
    p.y += (speed + pc.gravity * t) * dt;
    p.x += sin(p.y * pc.swayFreq + float(idx) * 0.3) * dt * pc.swayAmp;
    p.z += cos(p.y * pc.swayFreq * 1.2 + float(idx) * 0.4) * dt * pc.swayAmp * 0.7;
    if (pc.topDiffuse > 0.0 && p.y > pc.topThreshold) {
        p.x += (hash(idx*7u) - 0.5) * dt * pc.topDiffuse;
        p.z += (hash(idx*7u+1u) - 0.5) * dt * pc.topDiffuse;
    }

    p.w = life;
    uParticles.particles[idx] = p;
}
